{
  "name": "ds_landing_member_feed",
  "properties": {
    "linkedServiceName": {
      "referenceName": "ls_adls_gen2",
      "type": "LinkedServiceReference"
    },
    "parameters": {
      "fileName": {
        "type": "String",
        "defaultValue": "sample_member_feed.txt"
      },
      "container": {
        "type": "String",
        "defaultValue": "landing"
      }
    },
    "type": "DelimitedText",
    "typeProperties": {
      "location": {
        "type": "AzureBlobFSLocation",
        "fileName": {
          "value": "@dataset().fileName",
          "type": "Expression"
        },
        "fileSystem": {
          "value": "@dataset().container",
          "type": "Expression"
        }
      },
      "columnDelimiter": "|",
      "escapeChar": "\\\\",
      "firstRowAsHeader": false,
      "quoteChar": "\""
    }
  }
}