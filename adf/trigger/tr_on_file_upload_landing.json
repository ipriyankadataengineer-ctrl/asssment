{
  "name": "tr_on_file_upload_landing",
  "properties": {
    "description": "Event-based trigger passing incoming filename dynamically to pipeline parameters.",
    "annotations": [
      "SkyPoints",
      "EventDriven",
      "DynamicParameters"
    ],
    "type": "BlobEventsTrigger",
    "typeProperties": {
      "blobPathBeginsWith": "/landing/blobs/",
      "events": [
        "Microsoft.Storage.BlobCreated"
      ],
      "scope": "/subscriptions/9309ca0f-f25f-47e2-b887-bb4b9af961bf/resourceGroups/rg-skypoints-loyalty/providers/Microsoft.Storage/storageAccounts/stskypointsspeubmfodhieo"
    },
    "pipelines": [
      {
        "pipelineReference": {
          "referenceName": "pipeline_skypoints_orchestrator",
          "type": "PipelineReference"
        },
        "parameters": {
          "MemberFileName": "@triggerBody().fileName",
          "RedemptionFileName": "sample_redemptions.json",
          "LandingContainer": "landing"
        }
      }
    ]
  }
}