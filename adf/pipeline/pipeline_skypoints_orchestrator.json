{
  "name": "pipeline_skypoints_orchestrator",
  "properties": {
    "description": "Dynamic Production Orchestration Pipeline for SkyPoints Loyalty: Parameterized to handle any member flat file (.csv/.txt/.dat) and redemption JSON feed.",
    "parameters": {
      "MemberFileName": {
        "type": "string",
        "defaultValue": "sample_member_feed.txt"
      },
      "RedemptionFileName": {
        "type": "string",
        "defaultValue": "sample_redemptions.json"
      },
      "LandingContainer": {
        "type": "string",
        "defaultValue": "landing"
      }
    },
    "variables": {
      "PipelineStatus": {
        "type": "String",
        "defaultValue": "INITIALIZED"
      },
      "ExecutionLog": {
        "type": "String"
      }
    },
    "activities": [
      {
        "name": "Set_Status_Validating",
        "description": "Updates pipeline variable to track validation phase.",
        "type": "SetVariable",
        "dependsOn": [],
        "userProperties": [],
        "typeProperties": {
          "variableName": "PipelineStatus",
          "value": "VALIDATING_FEEDS"
        }
      },
      {
        "name": "Check_Member_Feed_Exists",
        "description": "Verifies that the parameterized daily member flat file feed has landed in ADLS Gen2 landing container.",
        "type": "GetMetadata",
        "dependsOn": [
          {
            "activity": "Set_Status_Validating",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "dataset": {
            "referenceName": "ds_landing_member_feed",
            "type": "DatasetReference",
            "parameters": {
              "fileName": {
                "value": "@pipeline().parameters.MemberFileName",
                "type": "Expression"
              },
              "container": {
                "value": "@pipeline().parameters.LandingContainer",
                "type": "Expression"
              }
            }
          },
          "fieldList": [
            "exists",
            "size"
          ],
          "storeSettings": {
            "type": "AzureBlobFSReadSettings",
            "recursive": false,
            "enablePartitionDiscovery": false
          }
        }
      },
      {
        "name": "Check_Redemption_Feed_Exists",
        "description": "Verifies that the parameterized daily JSON redemption feed has landed in ADLS Gen2 landing container.",
        "type": "GetMetadata",
        "dependsOn": [
          {
            "activity": "Set_Status_Validating",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "dataset": {
            "referenceName": "ds_landing_redemption_feed",
            "type": "DatasetReference",
            "parameters": {
              "fileName": {
                "value": "@pipeline().parameters.RedemptionFileName",
                "type": "Expression"
              },
              "container": {
                "value": "@pipeline().parameters.LandingContainer",
                "type": "Expression"
              }
            }
          },
          "fieldList": [
            "exists",
            "size"
          ],
          "storeSettings": {
            "type": "AzureBlobFSReadSettings",
            "recursive": false,
            "enablePartitionDiscovery": false
          }
        }
      },
      {
        "name": "Validate_Feeds_And_Process",
        "description": "Gatekeeper: Verifies both parameterized landing feeds exist before processing.",
        "type": "IfCondition",
        "dependsOn": [
          {
            "activity": "Check_Member_Feed_Exists",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "Check_Redemption_Feed_Exists",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "userProperties": [],
        "typeProperties": {
          "expression": {
            "value": "@and(activity('Check_Member_Feed_Exists').output.exists, activity('Check_Redemption_Feed_Exists').output.exists)",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "name": "Set_Status_Processing",
              "type": "SetVariable",
              "dependsOn": [],
              "userProperties": [],
              "typeProperties": {
                "variableName": "PipelineStatus",
                "value": "FEEDS_VERIFIED_PROCESSING"
              }
            }
          ],
          "ifFalseActivities": [
            {
              "name": "Set_Status_Awaiting_Feeds",
              "type": "SetVariable",
              "dependsOn": [],
              "userProperties": [],
              "typeProperties": {
                "variableName": "PipelineStatus",
                "value": "AWAITING_REMAINING_FEEDS"
              }
            }
          ]
        }
      },
      {
        "name": "Execute_Databricks_Loyalty_ETL",
        "description": "Executes distributed PySpark loyalty transformations with dynamic file parameters.",
        "type": "DatabricksNotebook",
        "dependsOn": [
          {
            "activity": "Validate_Feeds_And_Process",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "notebookPath": "/Shared/skypoints_databricks_pipeline",
          "baseParameters": {
            "member_file": {
              "value": "@pipeline().parameters.MemberFileName",
              "type": "Expression"
            },
            "redemption_file": {
              "value": "@pipeline().parameters.RedemptionFileName",
              "type": "Expression"
            },
            "container": {
              "value": "@pipeline().parameters.LandingContainer",
              "type": "Expression"
            }
          }
        },
        "linkedServiceName": {
          "referenceName": "ls_azure_databricks",
          "type": "LinkedServiceReference"
        }
      }
    ],
    "annotations": [
      "SkyPoints",
      "AirlineLoyalty",
      "MedallionArchitecture",
      "Parameterized"
    ]
  }
}